# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Tried in order if the main model is busy (503) or unavailable
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash
# Optional: lower = faster replies. Leave blank to use the model default.
GEMINI_THINKING_BUDGET=
PORT=8000
